{
  "appId": "com.lanshare.app",
  "productName": "Lanshare",
  "directories": {
    "output": "../releases/mac"
  },
  "files": ["dist/**/*", "dist-electron/**/*", "package.json"],
  "extraResources": [
    {
      "from": "backend/macos/arm64",
      "to": "backend/macos/arm64"
    }
  ],
  "publish": [
    {
      "provider": "github",
      "owner": "getawife",
      "repo": "lanshare"
    }
  ],
  "mac": {
    "target": [
      {
        "target": "dmg",
        "arch": ["arm64"]
      }
    ],
    "icon": "build/icon.icns"
  }
}
