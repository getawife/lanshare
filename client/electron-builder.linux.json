{
  "appId": "com.lanshare.app",
  "productName": "Lanshare",
  "directories": {
    "output": "../releases/linux"
  },
  "files": ["dist/**/*", "dist-electron/**/*", "package.json"],
  "extraResources": [
    {
      "from": "backend/linux",
      "to": "backend/linux"
    }
  ],
  "publish": [
    {
      "provider": "github",
      "owner": "getawife",
      "repo": "lanshare"
    }
  ],
  "linux": {
    "target": [
      {
        "target": "AppImage",
        "arch": ["x64", "arm64"]
      },
      {
        "target": "deb",
        "arch": ["x64", "arm64"]
      }
    ],
    "icon": "build/icon.png"
  }
}
